---
// The hero and the night share one pinned stage. Narration changes on the left while two phones play
// the night out on the right: Sam's, which notices, and Ava's, which is told.
import Logo from './Logo.astro';

const chapters = [
  { id: 'night', tag: 'Night mode', color: 'var(--sky)', title: 'It switches itself on', how: 'Leave your saved home places during your evening window and night mode starts by itself. There is nothing to set up each night, and your home places never leave the phone.' },
  { id: 'notice', tag: 'Detection', color: 'var(--butter)', title: 'It notices what you can’t say', how: 'A hit above 3 g, a tilt, then no steps and no touch for 15 s. A Rust engine on the phone opens a “down after fall” incident and turns the microphone on for a short listening window.' },
  { id: 'ask', tag: 'Check-in', color: 'var(--lilac)', title: 'It asks you first', how: 'A full-screen “You okay?” on the lock screen. Prove it’s you with your fingerprint, then type three random words. Nobody else has been told anything yet.' },
  { id: 'tell', tag: 'Heads-up', color: 'var(--coral)', title: 'Then it tells your friends', how: 'Two minutes and no answer. Your friends get “Sam might not be okay” and one sentence about what happened. They get no location yet.' },
  { id: 'unlock', tag: 'Location unlock', color: 'var(--coral)', title: 'Your location unlocks only now', how: 'Four minutes after the check-in, your phone seals two hours of location keys to each friend. Before this, nobody could read it: not one friend, and not the server.' },
  { id: 'act', tag: 'Friends decide', color: 'var(--mint)', title: 'Your friends decide what to do', how: 'Ring the phone loudly, call, say “I’m going”, mark you found. They can also call campus safety in one tap. The app never calls anyone on its own.' },
];

// Sam's motion while walking, the fall, then stillness: |a| in g, drawn into a 260×70 strip.
const wave: string[] = [];
for (let i = 0; i <= 260; i += 2) {
  let g = 1;
  if (i < 150) g = 1 + 0.38 * Math.sin(i / 4.2) + 0.12 * Math.sin(i / 1.7);
  else if (i < 158) g = 1 - (i - 150) * 0.11;
  else if (i < 166) g = 0.2 + (i - 158) * 0.48;
  else if (i < 172) g = 4.1 - (i - 166) * 0.5;
  else g = 1 + 0.03 * Math.sin(i * 1.3);
  const y = 66 - Math.min(g, 4.3) * 14.5;
  wave.push(`${i === 0 ? 'M' : 'L'}${i} ${y.toFixed(1)}`);
}
const wavePath = wave.join(' ');

const friends = [
  { name: 'Ava', x: 168, y: 92, c: 'var(--mint)' },
  { name: 'Jo', x: 86, y: 160, c: 'var(--mint)' },
  { name: 'Kai', x: 182, y: 176, c: 'var(--mint)' },
];
---
<section class="story" id="story" data-story>
  <div class="story__stage">
    <div class="story__grid">
      <div class="story__narration">
        <article class="narr narr--hero" data-hero>
          <p class="chip"><span class="dot" style="background: var(--mint); box-shadow: 0 0 0 1.5px var(--cream)"></span>Passive night-out safety for Android</p>
          <h1>The friend who notices when you <span class="scrawl">can’t ask<svg viewBox="0 0 300 20" preserveAspectRatio="none" aria-hidden="true"><path d="M3 14 C 60 4, 120 18, 180 9 S 270 6, 297 11" /></svg></span></h1>
          <p class="lead">pip runs quietly on a night out. When it looks like you can’t ask for help, it asks <em>you</em> first. Your friends hear only if you don’t answer, and your location stays encrypted until then.</p>
          <div class="hero__actions">
            <a class="btn btn--main" href="#signals">See what it notices</a>
            <a class="btn" href="#privacy">How privacy works</a>
          </div>
        </article>
        {chapters.map((c, i) => (
          <article class="narr" data-chapter={c.id}>
            <p class="narr__tag"><span class="narr__n" style={`background: ${c.color}`}>{i + 1}</span>{c.tag}</p>
            <h2>{c.title}</h2>
            <p class="narr__how">{c.how}</p>
          </article>
        ))}
        <ol class="story__dots" aria-hidden="true">
          {chapters.map((c) => <li style={`--c: ${c.color}`}></li>)}
        </ol>
      </div>

      <div class="story__phones" data-phones>
        <div class="halo" data-halo aria-hidden="true"></div>
        <div class="rings" data-rings aria-hidden="true"><i></i><i></i><i></i></div>

        <div class="phones__fit">
        <!-- Sam's phone -->
        <div class="phone phone--you" data-phone-you>
          <div class="phone__screen">
            <div class="sbar"><span data-clock>19:58</span><span class="sbar__r"><i class="sbar__sig"></i><i class="sbar__bat"></i></span></div>

            <div class="scr scr-home" data-scr-home>
              <div class="ph-head">
                <span class="ph-brand"><Logo />pip</span>
                <span class="np" data-np>
                  <span class="np__a"><i class="np__dot"></i>Home · off</span>
                  <span class="np__b"><i class="np__dot np__dot--on"></i>Night mode · on</span>
                </span>
              </div>
              <div class="radar">
                <svg viewBox="0 0 260 260" aria-hidden="true">
                  <circle class="radar__ring" cx="130" cy="130" r="40" />
                  <circle class="radar__ring" cx="130" cy="130" r="80" />
                  <circle class="radar__ring" cx="130" cy="130" r="120" />
                  <path class="radar__sweep" data-sweep d="M130 130 L130 10 A120 120 0 0 1 233.9 70 Z" />
                  <g data-home-icon>
                    <path class="radar__house" d="M112 136 L130 120 L148 136 L148 154 L112 154 Z" />
                    <path class="radar__door" d="M126 154 L126 143 L134 143 L134 154" />
                  </g>
                  <ellipse class="radar__zone" data-zone cx="150" cy="140" rx="64" ry="54" />
                  {friends.map((f) => (
                    <g class="radar__friend" data-friend>
                      <circle cx={f.x} cy={f.y} r="8" fill={f.c} />
                      <text x={f.x} y={f.y + 21}>{f.name}</text>
                    </g>
                  ))}
                  <g data-you>
                    <circle class="radar__pulse" cx="130" cy="130" r="10" />
                    <circle class="radar__you" cx="130" cy="130" r="9" />
                  </g>
                </svg>
              </div>
              <div class="sheet">
                <span class="sheet__handle"></span>
                <p class="sheet__line" data-sheet-a>You’re home. Have a good night.</p>
                <p class="sheet__line sheet__line--b" data-sheet-b>Out with Ava, Jo and Kai. Everyone’s okay.</p>
                <div class="hold"><span class="hold__ring"></span>Hold for help</div>
                <div class="okay">I’m okay</div>
              </div>
            </div>

            <div class="sense" data-sense>
              <div class="sense__head"><span>Motion · |a| in g</span><span class="sense__hz">50 Hz</span></div>
              <svg class="sense__wave" viewBox="0 0 260 70" preserveAspectRatio="none" aria-hidden="true">
                <rect class="sense__band" x="0" y="44" width="260" height="14" />
                <line class="sense__limit" x1="0" x2="260" y1="22.5" y2="22.5" />
                <text class="sense__limit-t" x="256" y="18">3 g</text>
                <path class="sense__line" data-wave d={wavePath} />
              </svg>
              <div class="sense__chips">
                <span class="inc inc--watch" data-inc-fall><i class="mark mark--watch"></i>Possible fall</span>
                <span class="inc inc--danger" data-inc-down><i class="mark mark--danger"></i>Down after fall</span>
                <span class="inc inc--mic" data-inc-mic><svg class="icon" viewBox="0 0 24 24"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11 a7 7 0 0 0 14 0 M12 18 V21"/></svg>Listening · 10 min</span>
              </div>
            </div>

            <div class="scr scr-check" data-scr-check>
              <p class="check__k">pip · check-in</p>
              <p class="check__q">You okay?</p>
              <p class="check__why">A possible fall, then no movement.</p>
              <div class="count">
                <svg viewBox="0 0 120 120" aria-hidden="true">
                  <circle class="count__track" cx="60" cy="60" r="50" />
                  <circle class="count__arc" data-count-arc cx="60" cy="60" r="50" pathLength="100" />
                </svg>
                <span class="count__t" data-count>2:00</span>
              </div>
              <p class="check__hint">Type these words</p>
              <p class="check__words"><span>maple</span><span>orbit</span><span>tulip</span></p>
              <div class="check__btns">
                <span class="mini-btn mini-btn--main">I’m OK</span>
                <span class="mini-btn mini-btn--coral">I need help</span>
              </div>
            </div>

            <div class="scr scr-told" data-scr-told>
              <div class="told__icon"><svg class="icon" viewBox="0 0 24 24"><path d="M4 12 a8 8 0 1 0 16 0 a8 8 0 1 0 -16 0 M12 7 V12 L15 14"/></svg></div>
              <p class="told__t">Your friends were told</p>
              <p class="told__s">Tap if you’re OK</p>
            </div>

            <div class="scr scr-safe" data-scr-safe>
              <div class="safe__tick"><svg class="icon" viewBox="0 0 24 24"><path d="M5 12.5 L9.5 17 L19 7.5"/></svg></div>
              <p class="told__t">Ava found you</p>
              <p class="told__s">Your friends know you’re safe.</p>
            </div>

            <div class="ringwaves" data-ringwaves aria-hidden="true"><i></i><i></i><i></i></div>
          </div>
        </div>

        <!-- Ava's phone -->
        <div class="phone phone--friend" data-phone-friend>
          <div class="phone__screen">
            <div class="sbar"><span data-clock2>23:46</span><span class="sbar__r"><i class="sbar__sig"></i><i class="sbar__bat"></i></span></div>
            <div class="notif" data-notif>
              <span class="notif__app"><Logo /></span>
              <div>
                <p class="notif__top"><b>pip</b> · now</p>
                <p class="notif__t">Sam might not be okay</p>
                <p class="notif__s">A possible fall, then down for 2 min, then no answer to a check-in.</p>
              </div>
            </div>
            <div class="fr">
              <div class="fr__head">
                <span class="fr__av">S</span>
                <div><p class="fr__name">Sam</p><p class="fr__lvl" data-fr-lvl><span class="fr__lvl-a">Heads-up · just now</span><span class="fr__lvl-b">Location shared · logged</span><span class="fr__lvl-c">Found safe</span></p></div>
              </div>
              <div class="map" data-map>
                <svg class="map__svg" viewBox="0 0 240 170" aria-hidden="true">
                  <rect width="240" height="170" fill="#F2E6CF" />
                  <path class="map__park" d="M150 20 h70 v56 h-70 z" />
                  <path class="map__road" d="M-10 60 L250 40 M-10 128 L250 112 M60 -10 L80 180 M178 -10 L160 180" />
                  <path class="map__lane" d="M-10 92 L250 80 M120 -10 L124 180" />
                  <circle class="map__acc" cx="112" cy="94" r="22" />
                </svg>
                <div class="map__pin" data-pin><span>S</span></div>
                <div class="map__lock" data-lock>
                  <svg class="icon" viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="10" rx="2.5"/><path d="M8 11 V8 a4 4 0 0 1 8 0 V11"/></svg>
                  <span>Location sealed</span>
                  <code data-cipher>9f3a·c41e·77b0·e2d9</code>
                </div>
              </div>
              <p class="fr__summary">A possible fall, then down for 2 min, then no answer to a check-in.</p>
              <div class="fr__acts">
                <span class="act" data-act-ring>Ring</span>
                <span class="act">Call</span>
                <span class="act" data-act-go>I’m going</span>
                <span class="act act--mint" data-act-found>Found safe</span>
              </div>
            </div>
            <div class="found" data-found><svg class="icon" viewBox="0 0 24 24"><path d="M5 12.5 L9.5 17 L19 7.5"/></svg>Sam is safe</div>
          </div>
        </div>

        <div class="keys" data-keys aria-hidden="true">
          {[0, 1, 2].map(() => (
            <svg class="key" viewBox="0 0 32 32"><circle cx="10" cy="16" r="6"/><path d="M16 16 H29 M24 16 V21 M28 16 V20"/></svg>
          ))}
        </div>
        </div>
      </div>
    </div>

    <div class="story__hint" data-hint aria-hidden="true">
      <span>Scroll through a night out</span>
      <svg class="icon" viewBox="0 0 24 24"><path d="M12 5 L12 19 M6 13 L12 19 L18 13"/></svg>
    </div>
  </div>
</section>
