---
const points = [
  ['Live sensor view', 'Motion and rotation at 10 frames a second over one Realtime connection. Nothing is stored, and it never carries location.'],
  ['An incident log made for scanning', 'Plain names, “2 min ago”, a status like “Active · 3 min so far”, severity as a coloured edge, and one box per episode.'],
  ['An escalation dock', 'It appears while an alert is open, turns red and beeps when a step is overdue, and holds every friend action and the map.'],
  ['An AI read that shows its working', 'The incident timeline (names, order, gaps; never measurements, location or audio) goes to Claude Haiku from the friend’s browser. It is advisory only: the engine’s own alert level sets a floor.'],
];
---
<section class="band band--ink band--round" id="monitor">
  <div class="wrap">
    <div class="band__head" data-reveal>
      <p class="eyebrow" style="--eyebrow: var(--mint)">For friends</p>
      <h2 data-words>Your friends see what they need, and nothing more</h2>
      <p class="lead">Friends follow along in the app, or on a laptop with the web monitor. It is the same code built for the browser, with the Rust crypto compiled to WebAssembly, so a released location decrypts on the friend’s own device.</p>
    </div>

    <div class="mon" data-monitor data-reveal>
      <div class="mon__bar">
        <span class="mon__lights"><i></i><i></i><i></i></span>
        <span class="mon__url">pip · monitor · Sam</span>
        <span class="mon__live"><i></i>live</span>
      </div>
      <div class="mon__grid">
        <div class="mon__col mon__col--live">
          <div class="mon__who">
            <span class="fr__av">S</span>
            <div><p class="mon__name">Sam</p><p class="mon__sub" data-mon-sub>Out tonight · with Ava</p></div>
          </div>
          <canvas class="mon__wave" data-mon-wave aria-hidden="true"></canvas>
          <div class="mon__tiles">
            <div><span>Cadence</span><b data-mt="0">104</b></div>
            <div><span>Sway</span><b data-mt="1" class="is-out">2.4</b></div>
            <div><span>Battery</span><b>61 %</b></div>
            <div><span>Round trip</span><b data-mt="3">84 ms</b></div>
          </div>
        </div>

        <div class="mon__col mon__col--log">
          <p class="mon__k">Incident log</p>
          <ol class="log" data-log></ol>
        </div>

        <div class="mon__col mon__col--ai">
          <p class="mon__k">AI read <small>advisory</small></p>
          <div class="ai">
            <div class="ai__dial">
              <svg viewBox="0 0 120 70" aria-hidden="true"><path class="ai__track" d="M10 64 A50 50 0 0 1 110 64" /><path class="ai__arc" data-ai-arc d="M10 64 A50 50 0 0 1 110 64" pathLength="100" /></svg>
              <b data-ai-score>0</b>
            </div>
            <div>
              <p class="ai__lvl" data-ai-lvl>Calm</p>
              <p class="ai__traj" data-ai-traj>Nothing to read yet</p>
            </div>
          </div>
          <ol class="contrib" data-contrib></ol>
          <p class="ai__floor" data-ai-floor>Engine level: idle</p>
        </div>
        <svg class="mon__wires" data-wires aria-hidden="true"></svg>
      </div>
      <div class="dock" data-dock>
        <span class="dock__t"><i></i><span data-dock-t>Heads-up open</span></span>
        <span class="dock__acts"><span>Ring</span><span>Call</span><span>I’m going</span><span class="is-mint">Found safe</span></span>
      </div>
    </div>

    <div class="mpoints" data-reveal="children">
      {points.map(([t, b]) => (
        <div class="mpoint"><h3>{t}</h3><p>{b}</p></div>
      ))}
    </div>
  </div>
</section>
